+#!/usr/bin/env python3
+"""Safety checks for the inactive Linux cutover reconciler."""
+
+import argparse
+import copy
+import importlib.machinery
+import importlib.util
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+SCRIPT = Path(__file__).with_name("reconcile-mica-agent-definitions")
+LOADER = importlib.machinery.SourceFileLoader("mica_reconciler", str(SCRIPT))
+SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
+assert SPEC is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+LOADER.exec_module(MODULE)
+PREPARER = Path(__file__).with_name("test_prepare_mica_agent_handoff.py")
+LOADER2 = importlib.machinery.SourceFileLoader("mica_preparer_tests", str(PREPARER))
+SPEC2 = importlib.util.spec_from_loader(LOADER2.name, LOADER2)
+assert SPEC2 is not None
+HELPER = importlib.util.module_from_spec(SPEC2)
+LOADER2.exec_module(HELPER)
+
+SKILL_ID = "3b055ec6-b733-44b9-994c-99762ecf78a4"
+LEGACY_ID = "836067d8-86f2-4395-bcb0-35be482ad4b6"
+
+
+def fixture(directory):
+    source = HELPER.source_manifest(directory)
+    loader = importlib.machinery.SourceFileLoader("mica_prep_fixture", str(SCRIPT.with_name("prepare-mica-agent-handoff")))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    prep = importlib.util.module_from_spec(spec)
+    loader.exec_module(prep)
+    desired = prep.build_handoff(SKILL_ID, source)
+    path = Path(directory) / "desired.json"
+    path.write_text(json.dumps(desired))
+    return desired, path, source
+
+
+def live_for(agent, workspace):
+    live = {key: copy.deepcopy(value) for key, value in agent.items() if key not in ("skill_ids", "builtin_skill_replacements")}
+    live.update({
+        "workspace_id": workspace,
+        "runtime_bound": True,
+        "status": "idle",
+        "skills": [{"id": LEGACY_ID}],
+        "disabled_runtime_skills": [{"id": value} for value in agent["disabled_runtime_skill_ids"]],
+        "builtin_skill_replacements": {},
+        "builtin_skills": [{"id": "builtin:multica-platform", "enabled": False},
+                           {"id": "builtin:multica-working-on-issues", "enabled": True},
+                           {"id": "builtin:multica-onboarding", "enabled": False}],
+        "enabled_builtin_skill_ids": ["builtin:multica-working-on-issues"],
+        "invocation_targets": ([{"target_type": "workspace", "target_id": workspace}] if agent["public_to_workspace"] else []),
+    })
+    return live
+
+
+class ReconcilerTests(unittest.TestCase):
+    def test_import_readback_checks_every_packaged_file(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, _, source = fixture(directory)
+            packaged = json.loads(source.read_text())["packaged_file_hashes_sha256"]
+            files = [{"path": path, "content_hash": digest, "size": 1}
+                     for path, digest in packaged.items() if path != "SKILL.md"]
+            files.append({"path": "source-manifest.json", "content_hash": MODULE.hashlib.sha256(source.read_bytes()).hexdigest(),
+                          "size": len(source.read_bytes())})
+            skill = {"id": SKILL_ID, "workspace_id": desired["workspace_id"],
+                     "name": desired["imported_skill"]["name"], "content_hash": packaged["SKILL.md"], "files": files}
+            class Client:
+                def request(self, method, path):
+                    self.path = path
+                    return skill
+            client = Client()
+            MODULE.verify_import(client, desired, source)
+            self.assertTrue(client.path.endswith("?include=metadata"))
+            files[0]["content_hash"] = "0" * 64
+            with self.assertRaisesRegex(MODULE.ReconcileError, "bundle files differ"):
+                MODULE.verify_import(client, desired, source)
+
+    def test_resolved_state_rejects_profile_or_manifest_drift(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, path, source = fixture(directory)
+            self.assertEqual(MODULE.load_desired(path, source), desired)
+            desired["updates"][0]["model"] = "wrong"
+            path.write_text(json.dumps(desired))
+            with self.assertRaisesRegex(MODULE.ReconcileError, "differs"):
+                MODULE.load_desired(path, source)
+
+    def test_protected_changes_and_unexpected_skills_fail_closed(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, _, _ = fixture(directory)
+            agent = desired["updates"][0]
+            live = live_for(agent, desired["workspace_id"])
+            self.assertIn("skill_ids", MODULE.inspect_agent(live, agent, desired["workspace_id"], LEGACY_ID))
+            other_permission = "private" if agent["permission_mode"] == "public_to" else "public_to"
+            for field, value in (("status", "busy"), ("runtime_id", "other"), ("permission_mode", other_permission)):
+                changed = copy.deepcopy(live)
+                changed[field] = value
+                with self.subTest(field=field), self.assertRaises(MODULE.ReconcileError):
+                    MODULE.inspect_agent(changed, agent, desired["workspace_id"], LEGACY_ID)
+            changed = copy.deepcopy(live)
+            changed["skills"].append({"id": SKILL_ID})
+            with self.assertRaisesRegex(MODULE.ReconcileError, "unexpected direct skill"):
+                MODULE.inspect_agent(changed, agent, desired["workspace_id"], LEGACY_ID)
+            changed = copy.deepcopy(live)
+            changed["builtin_skill_replacements"]["builtin:other"] = SKILL_ID
+            with self.assertRaisesRegex(MODULE.ReconcileError, "unrecognized"):
+                MODULE.inspect_agent(changed, agent, desired["workspace_id"], LEGACY_ID)
+
+    def test_apply_uses_supported_endpoints_and_removes_old_direct_binding_last(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, _, _ = fixture(directory)
+            agent = desired["updates"][0]
+            live = live_for(agent, desired["workspace_id"])
+            calls = []
+            class Client:
+                def request(self, method, path, body=None):
+                    calls.append((method, path, body))
+            operations = MODULE.inspect_agent(live, agent, desired["workspace_id"], LEGACY_ID)
+            MODULE.apply_agent(Client(), agent, live, operations)
+            self.assertIn("/builtin-skills/replacements", calls[-2][1])
+            self.assertTrue(calls[-1][1].endswith("/skills"))
+            self.assertEqual(calls[-1][2], {"skill_ids": []})
+            self.assertFalse(any("/builtins" in path for _, path, _ in calls))
+            self.assertEqual(calls[-2][2]["replacement_skill_id"], SKILL_ID)
+
+    def test_apply_requires_workspace_confirmation_before_token_or_network(self):
+        with tempfile.TemporaryDirectory() as directory:
+            _, path, source = fixture(directory)
+            args = argparse.Namespace(command="apply", desired_state=path, source_manifest=source,
+                                      confirm_workspace_id="wrong", token_file=Path(directory) / "token",
+                                      api_url="https://example.test", confirm_linux_daemons_stopped=False)
+            with mock.patch.object(MODULE, "read_token") as read_token:
+                with self.assertRaisesRegex(MODULE.ReconcileError, "confirm-workspace-id"):
+                    MODULE.run(args)
+                read_token.assert_not_called()
+
+    def test_all_linux_agents_are_checked_before_first_write(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, path, source = fixture(directory)
+            linux = [agent for agent in desired["updates"] if agent["environment"] in MODULE.LINUX]
+            responses = {agent["id"]: live_for(agent, desired["workspace_id"]) for agent in linux}
+            responses[linux[-1]["id"]]["status"] = "busy"
+            calls = []
+            class Client:
+                def __init__(self, *_args):
+                    pass
+                def request(self, method, route, body=None):
+                    calls.append((method, route))
+                    return responses[route.rsplit("/", 1)[-1]]
+            args = argparse.Namespace(command="apply", desired_state=path, source_manifest=source,
+                                      confirm_workspace_id=desired["workspace_id"], token_file=Path(directory) / "token",
+                                      api_url="https://example.test", confirm_linux_daemons_stopped=True)
+            with mock.patch.object(MODULE, "read_token", return_value="secret"), \
+                 mock.patch.object(MODULE, "Client", Client), \
+                 mock.patch.object(MODULE, "verify_import"), \
+                 mock.patch.object(MODULE, "verify_linux_daemons_stopped"):
+                with self.assertRaisesRegex(MODULE.ReconcileError, "idle"):
+                    MODULE.run(args)
+            self.assertEqual(len(calls), len(linux))
+            self.assertTrue(all(method == "GET" for method, _ in calls))
+
+    def test_apply_requires_operator_stop_and_offline_runtime_readback(self):
+        with tempfile.TemporaryDirectory() as directory:
+            desired, path, source = fixture(directory)
+            args = argparse.Namespace(command="apply", desired_state=path, source_manifest=source,
+                                      confirm_workspace_id=desired["workspace_id"], token_file=Path(directory) / "token",
+                                      api_url="https://example.test", confirm_linux_daemons_stopped=False)
+            with mock.patch.object(MODULE, "read_token") as read_token:
+                with self.assertRaisesRegex(MODULE.ReconcileError, "daemons-stopped"):
+                    MODULE.run(args)
+                read_token.assert_not_called()
+            class Client:
+                def request(self, method, route):
+                    self.route = route
+                    return []
+            client = Client()
+            with self.assertRaisesRegex(MODULE.ReconcileError, "missing from live inventory"):
+                MODULE.verify_linux_daemons_stopped(client, desired)
+            self.assertEqual(client.route, "/api/runtimes")
+            with MODULE.ENVIRONMENTS.open("rb") as stream:
+                import tomllib
+                configured = tomllib.load(stream)
+            rows = [{"id": row["runtime_id"], "daemon_id": row["daemon_id"],
+                     "workspace_id": desired["workspace_id"], "status": "offline"}
+                    for row in configured["environments"] if row["key"] in MODULE.LINUX]
+            client.request = lambda _method, _route: rows
+            MODULE.verify_linux_daemons_stopped(client, desired)
+            rows[-1]["status"] = "online"
+            with self.assertRaisesRegex(MODULE.ReconcileError, "not verified offline"):
+                MODULE.verify_linux_daemons_stopped(client, desired)
+
+    def test_token_file_permissions_and_api_origin_are_strict(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "token"
+            path.write_text("secret\n")
+            path.chmod(0o644)
+            with self.assertRaisesRegex(MODULE.ReconcileError, "0600"):
+                MODULE.read_token(path)
+            path.chmod(0o600)
+            self.assertEqual(MODULE.read_token(path), "secret")
+            for url in ("http://example.test", "https://user:pass@example.test", "https://example.test/api"):
+                with self.subTest(url=url), self.assertRaises(MODULE.ReconcileError):
+                    MODULE.validate_url(url)
+
+
+if __name__ == "__main__":
+    unittest.main()
