+++ b/scripts/prepare-mica-agent-handoff
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+"""Print an offline, inactive Mica agent update handoff as JSON."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+import re
+import tomllib
+import uuid
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent.parent
+PROFILE_PATH = ROOT / "config" / "mica-cutover-profile.toml"
+LEGACY_SCRIPT = ROOT / "scripts" / "trackself-agent-definitions"
+SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+
+
+def build_handoff(skill_id: str, source_manifest: Path) -> dict:
+    try:
+        skill_id = str(uuid.UUID(skill_id))
+    except ValueError as error:
+        raise ValueError("imported skill ID must be a UUID") from error
+    source_bytes = source_manifest.read_bytes()
+    source = json.loads(source_bytes)
+    if not isinstance(source, dict):
+        raise ValueError("source manifest must be an object")
+    identity = source.get("bundle_identity_sha256")
+    if (
+        source.get("schema_version") != 1
+        or source.get("policy_version") != "mica-v1"
+        or not isinstance(identity, str)
+        or not SHA256.fullmatch(identity)
+        or source.get("skill_name") != f"trackself-platform-{identity[:16]}"
+    ):
+        raise ValueError("source manifest has invalid Mica v1 bundle identity")
+    for field in ("source_hashes_sha256", "packaged_file_hashes_sha256"):
+        entries = source.get(field)
+        if not isinstance(entries, dict) or not entries or any(
+            not isinstance(path, str) or not path
+            or not isinstance(digest, str) or not SHA256.fullmatch(digest)
+            for path, digest in entries.items()
+        ):
+            raise ValueError(f"source manifest has invalid {field}")
+    skill_name = source["skill_name"]
+    # The current Multica platform combines the retired granular built-ins
+    # into these eight references. A replacement must preserve every domain.
+    required_files = {
+        "SKILL.md", "runtime/issue-workflow.md", "references/workflow.md",
+        "references/agents.md", "references/autopilots.md", "references/issues.md",
+        "references/mentions.md", "references/projects.md", "references/runtimes.md",
+        "references/skill-import.md", "references/squads.md",
+    }
+    if not required_files <= set(source["packaged_file_hashes_sha256"]):
+        raise ValueError("source manifest lacks the full platform replacement bundle")
+    source_digest = hashlib.sha256(source_bytes).hexdigest()
+    with PROFILE_PATH.open("rb") as stream:
+        profile = tomllib.load(stream)
+    if profile.get("schema_version") != 1 or profile.get("source_policy") != "fork/trackself/policies/mica-v1":
+        raise ValueError("candidate profile has invalid schema or policy source")
+    loader = importlib.machinery.SourceFileLoader("trackself_agent_definitions", str(LEGACY_SCRIPT))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    loader.exec_module(module)
+    legacy = module.load_manifest()
+    old_skill_ids = {skill["id"] for skill in legacy["skills"]}
+    if skill_id in old_skill_ids:
+        raise ValueError("the imported policy skill ID must differ from legacy managed skills")
+    agent_keys = {agent["key"] for agent in legacy["agents"]}
+    retired = profile.get("retire_from_new_routing")
+    if (not isinstance(retired, list) or any(not isinstance(key, str) for key in retired)
+            or len(set(retired)) != len(retired) or not set(retired) <= agent_keys):
+        raise ValueError("retire_from_new_routing must list unique known agent keys")
+    retired_keys = set(retired)
+    active = [agent for agent in legacy["agents"] if agent["key"] not in retired_keys]
+    roles = profile.get("roles")
+    if not isinstance(roles, dict) or set(roles) != {agent["role"] for agent in active}:
+        raise ValueError("candidate profile must cover exactly the retained roles")
+    for role, values in roles.items():
+        if not isinstance(values, dict) or any(
+            not isinstance(values.get(field), str) or not values[field].strip()
+            for field in ("model", "thinking_level", "purpose")
+        ):
+            raise ValueError(f"role {role} needs model, thinking_level and purpose")
+    review_fix_role = profile.get("review_fix_route")
+    final_review_role = profile.get("final_review_route")
+    if (not isinstance(review_fix_role, str) or not isinstance(final_review_role, str)
+            or review_fix_role == final_review_role):
+        raise ValueError("review routes must name distinct retained roles")
+    active_by_environment = {(agent["environment"], agent["role"]): agent for agent in active}
+    environments = sorted({agent["environment"] for agent in active})
+    if any(
+        (environment, role) not in active_by_environment
+        for environment in environments
+        for role in (review_fix_role, final_review_role)
+    ):
+        raise ValueError("review routes must resolve to retained agents in every environment")
+    updates = []
+    excluded = []
+    for agent in legacy["agents"]:
+        if agent["key"] in retired_keys:
+            excluded.append({"key": agent["key"], "id": agent["id"], "environment": agent["environment"]})
+            continue
+        role_profile = profile["roles"][agent["role"]]
+        builtins = ["builtin:multica-platform"]
+        if agent["key"] == "mika":
+            builtins.append("builtin:multica-onboarding")
+        updates.append({
+            "key": agent["key"],
+            "id": agent["id"],
+            "name": agent["name"],
+            "description": agent["description"],
+            "role": agent["role"],
+            "environment": agent["environment"],
+            "runtime_id": agent["runtime_id"],
+            "credential_group": agent["credential_group"],
+            "permission_mode": agent["permission_mode"],
+            "visibility": agent["visibility"],
+            "public_to_workspace": agent["public_to_workspace"],
+            "has_custom_env": agent["has_custom_env"],
+            "custom_args": agent["custom_args"],
+            "model": role_profile["model"],
+            "thinking_level": role_profile["thinking_level"],
+            "service_tier": agent["service_tier"],
+            "instructions": agent["instructions"],
+            "skill_ids": [],
+            "disabled_runtime_skill_ids": agent["disabled_runtime_skill_ids"],
+            "builtin_skill_mode": "exact",
+            "enabled_builtin_skill_ids": sorted(builtins),
+            "builtin_skill_replacements": {"builtin:multica-platform": skill_id},
+            "max_concurrent_tasks": agent["max_concurrent_tasks"],
+        })
+    return {
+        "status": "inactive_handoff_only",
+        "workspace_id": legacy["workspace_id"],
+        "source_policy": profile["source_policy"],
+        "imported_skill": {"id": skill_id, "name": skill_name},
+        "source_manifest_sha256": source_digest,
+        "excluded_from_new_routing": excluded,
+        "excluded_record_action": "retain existing agent records and task/session history; do not delete or disable live agents",
+        "review_routes": [
+            {
+                "environment": environment,
+                "review_fix": {"key": active_by_environment[(environment, review_fix_role)]["key"], "id": active_by_environment[(environment, review_fix_role)]["id"]},
+                "final_review": {"key": active_by_environment[(environment, final_review_role)]["key"], "id": active_by_environment[(environment, final_review_role)]["id"]},
+            }
+            for environment in environments
+        ],
+        "updates": updates,
+        "required_before_apply": [
+            "verify bundle source-manifest.json and importer return for this exact ID",
+            "select and pin production policy defaults and authorized exceptions",
+            "verify supported agent update API and full read-back, including platform replacement",
+            "preserve old agent records and ticket sessions; migrate old tickets explicitly",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--imported-skill-id", required=True)
+    parser.add_argument("--source-manifest", required=True, type=Path)
+    parser.add_argument("--desired-state-out", type=Path,
+                        help="Create the persistent resolved desired state at this path")
+    args = parser.parse_args()
+    try:
+        output = json.dumps(build_handoff(args.imported_skill_id, args.source_manifest), indent=2) + "\n"
+        if args.desired_state_out is None:
+            print(output, end="")
+        else:
+            descriptor = os.open(args.desired_state_out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
+                stream.write(output)
+            print(f"desired_state_written={args.desired_state_out}")
+    except (ValueError, OSError, json.JSONDecodeError) as error:
+        parser.error(str(error))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
