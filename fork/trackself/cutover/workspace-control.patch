+MODULE = importlib.util.module_from_spec(SPEC)
+LOADER.exec_module(MODULE)
+
+
+def source_manifest(directory: str) -> Path:
+    source = Path(directory) / "source-manifest.json"
+    identity = "a" * 64
+    source.write_text(json.dumps({
+        "schema_version": 1,
+        "policy_version": "mica-v1",
+        "skill_name": f"trackself-platform-{identity[:16]}",
+        "bundle_identity_sha256": identity,
+        "source_hashes_sha256": {"policy/SKILL.md": "b" * 64},
+        "packaged_file_hashes_sha256": {
+            path: "c" * 64 for path in (
+                "SKILL.md", "runtime/issue-workflow.md", "references/workflow.md",
+                "references/agents.md", "references/autopilots.md", "references/issues.md",
+                "references/mentions.md", "references/projects.md", "references/runtimes.md",
+                "references/skill-import.md", "references/squads.md",
+            )
+        },
+    }))
+    return source
+
+
+class CandidateTests(unittest.TestCase):
+    def test_all_runtime_profiles_keep_identity_and_use_imported_skill(self) -> None:
+        skill_id = "3b055ec6-b733-44b9-994c-99762ecf78a4"
+        with tempfile.TemporaryDirectory() as directory:
+            handoff = MODULE.build_handoff(skill_id, source_manifest(directory))
+        agents = handoff["updates"]
+        self.assertEqual(len(agents), 24)
+        self.assertEqual(len(handoff["excluded_from_new_routing"]), 5)
+        self.assertEqual(len(handoff["review_routes"]), 5)
+        self.assertEqual(len({agent["id"] for agent in agents}), len(agents))
+        self.assertEqual({agent["environment"] for agent in agents}, {
+            "linux-container", "linux-branch", "linux-branch-2", "macos-native", "windows-native",
+        })
+        for agent in agents:
+            self.assertEqual(agent["skill_ids"], [])
+            self.assertEqual(agent["builtin_skill_mode"], "exact")
+            self.assertEqual(agent["enabled_builtin_skill_ids"],
+                             ["builtin:multica-onboarding", "builtin:multica-platform"]
+                             if agent["key"] == "mika" else ["builtin:multica-platform"])
+            self.assertEqual(agent["builtin_skill_replacements"], {"builtin:multica-platform": skill_id})
+        self.assertEqual({a["thinking_level"] for a in agents if a["role"] == "orchestrator"}, {"low"})
+        self.assertEqual({a["model"] for a in agents if a["role"] == "orchestrator"}, {"gpt-6-astra"})
+        self.assertEqual({a["model"] for a in agents if a["role"] == "implementor"}, {"gpt-6-luna"})
+        self.assertFalse({a["role"] for a in agents} & {"review_controller"})
+        self.assertEqual({route["review_fix"]["key"] for route in handoff["review_routes"]}, {
+            "senior_implementor", "senior_implementor_linux_branch", "senior_implementor_linux_branch_2",
+            "macos_senior_implementor", "windows_senior_implementor",
+        })
+
+    def test_legacy_skill_id_cannot_be_reused(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaisesRegex(ValueError, "must differ"):
+                MODULE.build_handoff("836067d8-86f2-4395-bcb0-35be482ad4b6", source_manifest(directory))
+
+    def test_incomplete_platform_reference_bundle_is_rejected(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            source = source_manifest(directory)
+            data = json.loads(source.read_text())
+            del data["packaged_file_hashes_sha256"]["references/squads.md"]
+            source.write_text(json.dumps(data))
+            with self.assertRaisesRegex(ValueError, "full platform replacement"):
+                MODULE.build_handoff("3b055ec6-b733-44b9-994c-99762ecf78a4", source)
+
+    def test_source_manifest_must_match_exact_policy_name(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            source = source_manifest(directory)
+            candidate = MODULE.build_handoff(
+                "3b055ec6-b733-44b9-994c-99762ecf78a4",
+                source,
+            )
+            self.assertEqual(len(candidate["source_manifest_sha256"]), 64)
+            data = json.loads(source.read_text())
+            data["skill_name"] = "trackself-platform-other"
+            source.write_text(json.dumps(data))
+            with self.assertRaisesRegex(ValueError, "invalid Mica v1 bundle identity"):
+                MODULE.build_handoff(
+                    "3b055ec6-b733-44b9-994c-99762ecf78a4",
+                    source,
+                )
+            source.write_text("[]")
+            with self.assertRaisesRegex(ValueError, "must be an object"):
+                MODULE.build_handoff("3b055ec6-b733-44b9-994c-99762ecf78a4", source)
+
+    def test_review_routes_are_selected_by_profile_and_must_be_retained(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
