+            with mock.patch.object(MODULE, "PROFILE_PATH", candidate):
+                handoff = MODULE.build_handoff("3b055ec6-b733-44b9-994c-99762ecf78a4", source)
+            self.assertEqual(
+                {route["review_fix"]["key"] for route in handoff["review_routes"]},
+                {"implementor", "implementor_linux_branch", "implementor_linux_branch_2",
+                 "macos_implementor", "windows_implementor"},
+            )
+            candidate.write_text(original.replace('review_fix_route = "senior_implementor"', 'review_fix_route = "review_controller"'))
+            with mock.patch.object(MODULE, "PROFILE_PATH", candidate):
+                with self.assertRaisesRegex(ValueError, "retained agents"):
+                    MODULE.build_handoff("3b055ec6-b733-44b9-994c-99762ecf78a4", source)
+
+    def test_live_apply_fails_before_provider_access(self) -> None:
+        script = Path(__file__).with_name("trackself-agent-definitions")
+        result = subprocess.run(
+            [sys.executable, str(script), "apply", "--confirm-workspace-id", "79b97585-6d1d-43cc-a611-db7e2f4faa62"],
+            capture_output=True, text=True, check=False,
