@@ -0,0 +1,46 @@
+# Inactive Mica v1 candidate. No live agent or ticket uses this file.
+schema_version = 1
+source_policy = "fork/trackself/policies/mica-v1"
+source_manifest = "source-manifest.json"
+legacy_manifest = "multica-agents.toml"
+# Exclude process-only review controllers from NEW Mica routing. Keep all five
+# live records and their old task/session history untouched until migration.
+retire_from_new_routing = [
+  "review_controller",
+  "review_controller_linux_branch",
+  "review_controller_linux_branch_2",
+  "macos_review_controller",
+  "windows_review_controller",
+]
+review_fix_route = "senior_implementor"
+final_review_route = "acceptance_reviewer"
+
+[roles.orchestrator]
+model = "gpt-6-astra"
+thinking_level = "low"
+purpose = "Mica outcome coordination, including runtime-specific variants"
+
+[roles.implementor]
+model = "gpt-6-luna"
+thinking_level = "xhigh"
+purpose = "bounded implementation with retained writer context"
+
+[roles.senior_implementor]
+model = "gpt-6-sol"
+thinking_level = "medium"
+purpose = "judgment-heavy implementation with retained writer context"
+
+[roles.acceptance_reviewer]
+model = "gpt-6-sol"
+thinking_level = "medium"
+purpose = "fresh independent read-only final review"
+
+[roles.qa]
+model = "gpt-6-sol"
+thinking_level = "medium"
+purpose = "optional native validation evidence"
+
+[roles.release_builder]
+model = "gpt-6-sol"
+thinking_level = "high"
+purpose = "optional authorized native artifact work"
