new file mode 100755
index 0000000..e05202d
--- /dev/null
+++ b/scripts/reconcile-mica-agent-definitions
@@ -0,0 +1,292 @@
+#!/usr/bin/env python3
+"""Check or explicitly apply the persisted Mica agent cutover on Linux."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+import stat
+import sys
+import tomllib
+import urllib.error
+import urllib.parse
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parent.parent
+PREPARER = Path(__file__).with_name("prepare-mica-agent-handoff")
+LINUX = {"linux-container", "linux-branch", "linux-branch-2"}
+PLATFORM = "builtin:multica-platform"
+ENVIRONMENTS = ROOT / "config" / "multica-project-workspace.toml"
+
+
+class ReconcileError(Exception):
+    pass
+
+
+def load_desired(path: Path, source_manifest: Path) -> dict[str, Any]:
+    desired = json.loads(path.read_text())
+    if not isinstance(desired, dict) or desired.get("status") != "inactive_handoff_only":
+        raise ReconcileError("desired state must be a prepared inactive handoff")
+    imported = desired.get("imported_skill")
+    if not isinstance(imported, dict) or not isinstance(imported.get("id"), str):
+        raise ReconcileError("desired state lacks an imported skill ID")
+    loader = importlib.machinery.SourceFileLoader("mica_preparer", str(PREPARER))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    loader.exec_module(module)
+    if desired != module.build_handoff(imported["id"], source_manifest):
+        raise ReconcileError("desired state differs from the current profile or source manifest")
+    return desired
+
+
+def validate_url(value: str) -> str:
+    parsed = urllib.parse.urlsplit(value)
+    local = parsed.hostname in {"localhost", "127.0.0.1", "::1"}
+    if (parsed.scheme != "https" and not (parsed.scheme == "http" and local)) or not parsed.netloc or parsed.username or parsed.password or parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
+        raise ReconcileError("API URL must be an HTTPS origin or a local HTTP origin")
+    return value.rstrip("/")
+
+
+def read_token(path: Path) -> str:
+    info = path.stat()
+    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_uid != os.getuid():
+        raise ReconcileError("token file must be a regular file owned by this user with mode 0600")
+    token = path.read_text().strip()
+    if not token or any(ord(char) <= 32 for char in token):
+        raise ReconcileError("token file must contain one nonempty token")
+    return token
+
+
+class Client:
+    def __init__(self, origin: str, workspace_id: str, token: str):
+        self.origin = validate_url(origin)
+        self.workspace_id = workspace_id
+        self.token = token
+        class NoRedirect(urllib.request.HTTPRedirectHandler):
+            def redirect_request(self, request, fp, code, msg, headers, new_url):
+                return None
+        self.opener = urllib.request.build_opener(NoRedirect)
+
+    def request(self, method: str, path: str, body: dict[str, Any] | None = None) -> Any:
+        data = None if body is None else json.dumps(body, separators=(",", ":")).encode()
+        request = urllib.request.Request(
+            self.origin + path,
+            data=data,
+            method=method,
+            headers={
+                "Authorization": "Bearer " + self.token,
+                "X-Workspace-ID": self.workspace_id,
+                "Content-Type": "application/json",
+            },
+        )
+        try:
+            with self.opener.open(request, timeout=20) as response:
+                raw = response.read(2_000_001)
+                if len(raw) > 2_000_000:
+                    raise ReconcileError(f"{method} {path}: response too large")
+                return json.loads(raw) if raw else None
+        except urllib.error.HTTPError as error:
+            raise ReconcileError(f"{method} {path}: HTTP {error.code}; response redacted") from error
+        except urllib.error.URLError as error:
+            raise ReconcileError(f"{method} {path}: connection failed; details redacted") from error
+
+
+def ids(rows: Any, label: str) -> list[str]:
+    if not isinstance(rows, list):
+        raise ReconcileError(f"{label} is not an array")
+    result = [row if isinstance(row, str) else row.get("id") if isinstance(row, dict) else None for row in rows]
+    if any(not isinstance(item, str) for item in result) or len(set(result)) != len(result):
+        raise ReconcileError(f"{label} has invalid or duplicate IDs")
+    return sorted(result)
+
+
+def verify_import(client: Client, desired: dict[str, Any], source_manifest: Path) -> None:
+    skill = desired["imported_skill"]
+    live = client.request("GET", "/api/skills/" + skill["id"] + "?include=metadata")
+    if not isinstance(live, dict) or live.get("id") != skill["id"] or live.get("workspace_id") != desired["workspace_id"] or live.get("name") != skill["name"]:
+        raise ReconcileError("imported skill identity does not match desired state")
+    files = live.get("files")
+    if not isinstance(files, list):
+        raise ReconcileError("imported skill files were not returned")
+    source_bytes = source_manifest.read_bytes()
+    packaged = json.loads(source_bytes)["packaged_file_hashes_sha256"]
+    if live.get("content_hash") != packaged["SKILL.md"]:
+        raise ReconcileError("imported root skill content differs from source manifest")
+    expected = {path: digest for path, digest in packaged.items() if path != "SKILL.md"}
+    expected["source-manifest.json"] = hashlib.sha256(source_bytes).hexdigest()
+    actual = {}
+    for row in files:
+        if not isinstance(row, dict) or not isinstance(row.get("path"), str) or row["path"] in actual:
+            raise ReconcileError("imported skill file list is malformed")
+        actual[row["path"]] = row.get("content_hash")
+    if actual != expected:
+        raise ReconcileError("imported bundle files differ from source manifest")
+    manifest_file = next(row for row in files if row["path"] == "source-manifest.json")
+    if manifest_file.get("size") != len(source_bytes):
+        raise ReconcileError("imported source manifest length differs")
+
+
+def verify_linux_daemons_stopped(client: Client, desired: dict[str, Any]) -> None:
+    with ENVIRONMENTS.open("rb") as stream:
+        environments = tomllib.load(stream)
+    if environments.get("workspace_id") != desired["workspace_id"]:
+        raise ReconcileError("runtime inventory workspace differs from desired state")
+    expected = {
+        row["runtime_id"]: row["daemon_id"]
+        for row in environments["environments"]
+        if row["key"] in LINUX
+    }
+    if len(expected) != len(LINUX):
+        raise ReconcileError("Linux runtime inventory is incomplete")
+    live = client.request("GET", "/api/runtimes")
+    if not isinstance(live, list):
+        raise ReconcileError("runtime inventory is not an array")
+    seen = set()
+    for row in live:
+        if not isinstance(row, dict):
+            raise ReconcileError("runtime inventory contains a malformed row")
+        runtime_id = row.get("id")
+        if runtime_id not in expected:
+            continue
+        if runtime_id in seen:
+            raise ReconcileError("runtime inventory contains a duplicate Linux runtime")
+        seen.add(runtime_id)
+        if (row.get("workspace_id") != desired["workspace_id"]
+                or row.get("daemon_id") != expected[runtime_id]
+                or row.get("status") != "offline"):
+            raise ReconcileError("Linux runtime is not verified offline with its declared daemon")
+    if seen != set(expected):
+        raise ReconcileError("Linux runtime is missing from live inventory")
+
+
+def inspect_agent(live: Any, agent: dict[str, Any], workspace_id: str, legacy_skill_id: str) -> list[str]:
+    if not isinstance(live, dict):
+        raise ReconcileError(f"{agent['key']}: agent response is not an object")
+    protected = ("id", "workspace_id", "runtime_id", "permission_mode", "visibility", "has_custom_env", "custom_args", "service_tier", "max_concurrent_tasks")
+    expected = {key: agent[key] for key in protected if key in agent}
+    expected["workspace_id"] = workspace_id
+    for key, value in expected.items():
+        if live.get(key) != value:
+            raise ReconcileError(f"{agent['key']}: protected {key} differs")
+    if live.get("runtime_bound") is not True or live.get("status") != "idle":
+        raise ReconcileError(f"{agent['key']}: agent must be runtime-bound and idle")
+    if ids(live.get("disabled_runtime_skills"), "disabled runtime skills") != sorted(agent["disabled_runtime_skill_ids"]):
+        raise ReconcileError(f"{agent['key']}: disabled runtime skills differ")
+    targets = live.get("invocation_targets")
+    want_targets = ([{"target_type": "workspace", "target_id": workspace_id}] if agent["public_to_workspace"] else [])
+    if targets != want_targets:
+        raise ReconcileError(f"{agent['key']}: invocation targets differ")
+    replacements = live.get("builtin_skill_replacements")
+    if not isinstance(replacements, dict) or any(key != PLATFORM or value != agent["builtin_skill_replacements"][PLATFORM] for key, value in replacements.items()):
+        raise ReconcileError(f"{agent['key']}: unrecognized built-in replacement")
+    current_skills = ids(live.get("skills"), "agent skills")
+    if current_skills not in ([], [legacy_skill_id]):
+        raise ReconcileError(f"{agent['key']}: unexpected direct skill binding")
+    inventory = live.get("builtin_skills")
+    if not isinstance(inventory, list):
+        raise ReconcileError(f"{agent['key']}: no built-in inventory")
+    available = ids(inventory, "built-in inventory")
+    if not set(agent["enabled_builtin_skill_ids"]) <= set(available):
+        raise ReconcileError(f"{agent['key']}: desired built-in is unavailable")
+    enabled = live.get("enabled_builtin_skill_ids")
+    if enabled is not None and (not isinstance(enabled, list) or any(not isinstance(item, str) for item in enabled)):
+        raise ReconcileError(f"{agent['key']}: malformed built-in allowlist")
+    operations = []
+    for field in ("model", "thinking_level", "instructions"):
+        if live.get(field) != agent[field]:
+            operations.append(field)
+    if enabled is None or sorted(enabled) != agent["enabled_builtin_skill_ids"]:
+        operations.append("enabled_builtin_skill_ids")
+    if replacements.get(PLATFORM) != agent["builtin_skill_replacements"][PLATFORM]:
+        operations.append("builtin_skill_replacements")
+    if current_skills:
+        operations.append("skill_ids")
+    return operations
+
+
+def apply_agent(client: Client, agent: dict[str, Any], live: dict[str, Any], operations: list[str]) -> None:
+    agent_path = "/api/agents/" + agent["id"]
+    fields = {key: agent[key] for key in ("model", "thinking_level", "instructions") if key in operations}
+    if fields:
+        client.request("PUT", agent_path, fields)
+    if "enabled_builtin_skill_ids" in operations:
+        # Reset clears unavailable retired IDs from an old exact allowlist.
+        client.request("DELETE", agent_path + "/builtin-skills")
+        for built_in in ids(live["builtin_skills"], "built-in inventory"):
+            if built_in not in agent["enabled_builtin_skill_ids"]:
+                client.request("PUT", agent_path + "/builtin-skills/enabled", {"skill_id": built_in, "enabled": False})
+        # An inherit-all inventory exactly equal to desired still needs an
+        # explicit policy; toggle one ID off and back on.
+        if set(ids(live["builtin_skills"], "built-in inventory")) == set(agent["enabled_builtin_skill_ids"]):
+            pivot = agent["enabled_builtin_skill_ids"][0]
+            client.request("PUT", agent_path + "/builtin-skills/enabled", {"skill_id": pivot, "enabled": False})
+            client.request("PUT", agent_path + "/builtin-skills/enabled", {"skill_id": pivot, "enabled": True})
+    if "builtin_skill_replacements" in operations:
+        client.request("PUT", agent_path + "/builtin-skills/replacements", {"skill_id": PLATFORM, "replacement_skill_id": agent["builtin_skill_replacements"][PLATFORM]})
+    if "skill_ids" in operations:
+        client.request("PUT", agent_path + "/skills", {"skill_ids": []})
+
+
+def run(args: argparse.Namespace) -> int:
+    desired = load_desired(args.desired_state, args.source_manifest)
+    if args.command == "apply" and args.confirm_workspace_id != desired["workspace_id"]:
+        raise ReconcileError("apply requires the exact --confirm-workspace-id")
+    if args.command == "apply" and not args.confirm_linux_daemons_stopped:
+        raise ReconcileError("apply requires --confirm-linux-daemons-stopped after stopping all three Linux daemons")
+    token = read_token(args.token_file)
+    client = Client(args.api_url, desired["workspace_id"], token)
+    verify_import(client, desired, args.source_manifest)
+    if args.command == "apply":
+        verify_linux_daemons_stopped(client, desired)
+    legacy_skill_id = "836067d8-86f2-4395-bcb0-35be482ad4b6"
+    selected = [agent for agent in desired["updates"] if agent["environment"] in LINUX]
+    preflight = []
+    for agent in selected:
+        live = client.request("GET", "/api/agents/" + agent["id"])
+        operations = inspect_agent(live, agent, desired["workspace_id"], legacy_skill_id)
+        preflight.append((agent, live, operations))
+    for agent, _live, operations in preflight:
+        print(f"{agent['key']}: {','.join(operations) if operations else 'in_sync'}")
+    if args.command == "check":
+        return 1 if any(operations for _, _, operations in preflight) else 0
+    if args.command == "plan":
+        return 0
+    for agent, live, operations in preflight:
+        if not operations:
+            continue
+        verify_linux_daemons_stopped(client, desired)
+        apply_agent(client, agent, live, operations)
+        after = client.request("GET", "/api/agents/" + agent["id"])
+        remaining = inspect_agent(after, agent, desired["workspace_id"], legacy_skill_id)
+        if remaining:
+            raise ReconcileError(f"{agent['key']}: read-back drift remains: {remaining}")
+    print(f"mica_agent_definitions=in_sync agents={len(selected)} scope=linux")
+    return 0
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("command", nargs="?", default="plan", choices=["plan", "check", "apply"])
+    parser.add_argument("--desired-state", required=True, type=Path)
+    parser.add_argument("--source-manifest", required=True, type=Path)
+    parser.add_argument("--api-url", required=True)
+    parser.add_argument("--token-file", required=True, type=Path)
+    parser.add_argument("--confirm-workspace-id")
+    parser.add_argument("--confirm-linux-daemons-stopped", action="store_true")
+    args = parser.parse_args()
+    try:
+        return run(args)
+    except (ReconcileError, OSError, ValueError, json.JSONDecodeError) as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
